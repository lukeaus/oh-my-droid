{
  "name": "oh-my-droid",
  "version": "4.0.0",
  "description": "Multi-agent orchestration system for Factory Droid",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./bridge/hud.cjs": "./bridge/hud.cjs"
  },
  "bin": {
    "oh-my-droid": "dist/cli/index.js",
    "omd": "dist/cli/index.js",
    "omd-analytics": "dist/cli/analytics.js",
    "omd-cli": "dist/cli/index.js"
  },
  "files": [
    "dist",
    "droids",
    "bridge",
    "commands",
    "hooks",
    "scripts",
    "skills",
    "templates",
    "docs",
    ".factory-plugin/plugin.json",
    ".mcp.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc && node scripts/build-skill-bridge.mjs && node scripts/build-mcp-server.mjs && node scripts/build-hud.mjs && node scripts/build-hook-runtime.mjs",
    "build:bridge": "node scripts/build-skill-bridge.mjs",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src",
    "format": "prettier --write src/**/*.ts",
    "sync-metadata": "tsx scripts/sync-metadata.ts",
    "sync-metadata:verify": "tsx scripts/sync-metadata.ts --verify",
    "sync-metadata:dry-run": "tsx scripts/sync-metadata.ts --dry-run",
    "prepare": "npm run build",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@ast-grep/napi": "^0.31.0",
    "@modelcontextprotocol/sdk": "^1.26.0",
    "@tokscale/core": "^1.0.25",
    "ajv": "^8.17.1",
    "chalk": "^6.0.0",
    "commander": "^15.0.0",
    "jsonc-parser": "^3.3.1",
    "safe-regex": "^2.1.1",
    "vscode-languageserver-protocol": "^3.17.5",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.5.0",
    "@typescript-eslint/eslint-plugin": "^8.18.2",
    "@typescript-eslint/parser": "^8.18.2",
    "@vitest/ui": "^5.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.10.0",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.53.0",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": "^22.13.0 || ^24.0.0 || ^26.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lukeaus/oh-my-droid.git"
  },
  "homepage": "https://github.com/lukeaus/oh-my-droid#readme",
  "bugs": {
    "url": "https://github.com/lukeaus/oh-my-droid/issues"
  },
  "author": "Jio Kim",
  "license": "MIT",
  "keywords": [
    "droid",
    "factory-droid",
    "factory-ai",
    "ai",
    "agent",
    "multi-agent",
    "orchestration",
    "omd",
    "llm"
  ],
  "publishConfig": {
    "access": "public"
  }
}
